#!/usr/bin/env python3
"""Shortcut for the crossword sandbox.

./crossword                  -> opens the sandbox, saving the schemas in schemas.json
./crossword -s other.json    -> saves them in any other file
"""
import os
import sys

root = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(root, "src"))

from crossword.visualize import main

args = sys.argv[1:]
if not any(a in ("-s", "--store") or a.startswith("--store=") for a in args):
    args += ["--store", os.path.join(root, "schemas.json")]

raise SystemExit(main(args))
